# Puerto USB donde está conectado el Arduino (verifica con ls /dev/tty*)
ARDUINO_PORT=/dev/ttyUSB0

# Umbral de humedad para activar el riego (en porcentaje)
HUMIDITY_THRESHOLD=30

# Velocidad de comunicación serial (baud rate)
SERIAL_BAUD=9600

# Ruta del archivo de datos compartido entre main.py y dashboard.py
DATA_FILE=/app/datos_riego.json